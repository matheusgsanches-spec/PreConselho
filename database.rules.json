{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "courses": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 100",
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },
    "shifts": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 40",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    },
    "teachers": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['name', 'courseId', 'shiftId']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && root.child('courses').child(newData.child('courseId').val()).exists() && root.child('shifts').child(newData.child('shiftId').val()).exists()",
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "courseId": { ".validate": "newData.isString()" },
        "shiftId": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "questions": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "responses": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.exists() && newData.child('studentName').isString() && newData.child('studentName').val().length > 0 && newData.child('studentName').val().length <= 100 && newData.child('answers').hasChildren() && newData.child('createdAt').isString() && root.child('courses').child(newData.child('courseId').val()).exists() && root.child('shifts').child(newData.child('shiftId').val()).exists() && root.child('teachers').child(newData.child('teacherId').val()).child('courseId').val() === newData.child('courseId').val() && root.child('teachers').child(newData.child('teacherId').val()).child('shiftId').val() === newData.child('shiftId').val() && root.child('teachers').child(newData.child('teacherId').val()).child('name').val() === newData.child('teacherName').val() && root.child('courses').child(newData.child('courseId').val()).child('name').val() === newData.child('courseName').val() && root.child('shifts').child(newData.child('shiftId').val()).child('name').val() === newData.child('shiftName').val())",
        ".validate": "newData.hasChildren(['studentName', 'courseId', 'shiftId', 'teacherId', 'courseName', 'shiftName', 'teacherName', 'answers', 'createdAt'])",
        "studentName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "courseId": { ".validate": "newData.isString()" },
        "shiftId": { ".validate": "newData.isString()" },
        "teacherId": { ".validate": "newData.isString()" },
        "courseName": { ".validate": "newData.isString()" },
        "shiftName": { ".validate": "newData.isString()" },
        "teacherName": { ".validate": "newData.isString()" },
        "answers": {
          ".validate": "newData.hasChildren()",
          "$answerId": {
            ".validate": "newData.hasChildren(['prompt', 'type', 'value'])",
            "prompt": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180" },
            "type": { ".validate": "newData.isString() && (newData.val() === 'text' || newData.val() === 'choice')" },
            "value": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "$other": { ".validate": false }
          }
        },
        "createdAt": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
